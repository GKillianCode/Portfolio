{% extends 'base.html.twig' %} {% block title %}Page de connection - Portfolio
Killian GODET{% endblock %} {% block body %}
<div data-theme="dark">
    <section class="mx-auto max-w-7xl px-4 pb-20 relative">
        <a
            href="{{ path('home_index') }}"
            class="absolute top-8 bg-secondary hover:bg-primary duration-200 p-4 rounded-lg"
        >
            <twig:ux:icon name="tabler:home-filled" class="w-6" />
        </a>
        <div
            class="flex justify-center align-middle flex-col h-full"
            style="min-height: 100vh"
        >
            <h2 class="mb-8 text-2xl">Page de connexion</h2>

            {{ form_start(form) }}

            {% if error %}
            <div class="bg-error p-2 rounded-lg mb-6">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
            {% endif %}

            <div>
                {{ form_errors(form) }}
            </div>

            <div class="mb-4">
                {{ form_row(form._username) }}
            </div>

            <div class="mb-8">
                {{ form_row(form._password) }}
            </div>

            <button class="btn btn-primary">Se connecter</button>

            {{ form_end(form) }}
        </div>
    </section>
</div>
{% endblock %}
