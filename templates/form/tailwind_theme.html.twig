{% block form_row %} {% if form_errors(form) %}
<p class="mt-1 text-sm text-red-600">{{ form_errors(form) }}</p>
{% endif %}
{{
    form_label(form, null, {
        label_attr: {
            class: "mb-2 flex flex-1 flex-col block text-sm font-medium text-gray-100 mb-2"
        },
    })
}}
{{
    form_widget(form, {
        attr: {
            class: "p-2 block w-full rounded-md border-gray-300 shadow-sm
                        focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm bg-gray-100 text-gray-950"
        }
    })
}}
{% endblock %}
