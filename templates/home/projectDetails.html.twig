{% extends 'base.html.twig' %} {% block title %}Projet ABC - Portfolio Killian
GODET {% endblock %} {% block body %}

<section
    class="text-white px-5 py-5 md:py-16 md:px-6 m-2 md:m-10 rounded-2xl"
    style="background: var(--bg)"
>
    <div class="max-w-5xl mx-auto text-center">
        <h1
            class="text-2xl md:text-4xl font-bold mb-4 text-secondary dark:text-secondary"
        >
            {{ project.title }}
        </h1>
        <p class="text-md md:text-lg text-gray-100">
            {{ project.shortDescription }}
        </p>
        <div class="mt-6 flex justify-center gap-4 flex-col md:flex-row">
            <a href="#" class="px-6 py-3 bg-primary rounded-lg transition"
                >Voir le repo GitHub</a
            >
            <a href="#" class="px-6 py-3 bg-secondary rounded-lg transition"
                >Documentation API</a
            >
            <a href="#" class="px-6 py-3 bg-success rounded-lg transition"
                >Accéder à la démo</a
            >
        </div>
    </div>
</section>

<section class="max-w-5xl mx-auto py-16 px-6">
    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:compass-filled" class="w-6" /> Contexte du
        projet
    </h2>
    <p class="mb-6">
        {{ project.ctx }}
    </p>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:settings-filled" class="w-6" />
        Fonctionnalités principales
    </h2>
    <ul class="list-disc list-inside space-y-2 mb-6">
        {% for feature in project.mainFeatures %}
        <li>{{ feature }}</li>
        {% endfor %}
    </ul>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:tools" class="w-6" /> Stack technique
    </h2>
    <p class="mb-6">
        Symfony 6, PHP 8.3, Doctrine ORM, PostgreSQL, API Platform, JWT, Docker.
    </p>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:rocket" class="w-6" /> Défis et solutions
    </h2>
    <div class="space-y-4 mb-6">
        {% for challenge in project.challenges %}
        <li>{{ challenge }}</li>
        {% endfor %}
    </div>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:circle-check-filled" class="w-6" />
        Résultats et apprentissages
    </h2>
    <p class="mb-6">
        {{ project.result }}
    </p>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:camera" class="w-6" /> Visuels
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div
            class="bg-gray-200 rounded-lg h-48 flex items-center justify-center text-gray-500"
        >
            Capture Admin
        </div>
        <div
            class="bg-gray-200 rounded-lg h-48 flex items-center justify-center text-gray-500"
        >
            Exemple JSON
        </div>
    </div>
</section>

