{% extends 'base.html.twig' %} {% block title %}Projet ABC - Portfolio Killian
GODET {% endblock %} {% block body %}

<section
    class="text-white px-5 py-5 md:py-16 md:px-6 m-2 md:m-10 rounded-2xl"
    style="background: var(--bg)"
>
    <div class="max-w-5xl mx-auto text-center">
        <h1
            class="text-2xl md:text-4xl font-bold mb-4 text-secondary dark:text-secondary"
        >
            {{ project.title }}
        </h1>
        <p class="text-md md:text-lg text-gray-100">
            {{ project.shortDescription }}
        </p>
        {% if project.projectType.name == 'INTERN' %}
        <div class="mt-6 flex justify-center gap-4 flex-col md:flex-row">
            <a
                href="{{ project.repoLink }}"
                class="px-6 py-3 bg-primary rounded-lg transition"
                >Voir le repo</a
            >
            <a
                href="{{ project.docLink }}"
                class="px-6 py-3 bg-secondary rounded-lg transition"
                >Documentation API</a
            >
            <a
                href="{{ project.demoLink }}"
                class="px-6 py-3 bg-success rounded-lg transition"
                >Accéder à la démo</a
            >
        </div>
        {% else %}
        <div class="mt-6 flex justify-center">projet interne</div>
        {% endif %}
    </div>
</section>

<section class="max-w-5xl mx-auto py-16 px-6">
    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:compass-filled" class="w-6" /> Contexte du
        projet
    </h2>
    <p class="mb-8">
        {{ project.ctx }}
    </p>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:settings-filled" class="w-6" />
        Fonctionnalités principales
    </h2>
    <ul class="list-disc list-inside space-y-2 mb-8">
        {% for feature in project.mainFeatures %}
        <li>{{ feature }}</li>
        {% endfor %}
    </ul>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:tools" class="w-6" /> Stack technique
    </h2>
    <div class="mt-4 card-actions justify-start mb-8">
        {% for skillTag in project.skillTagsDTO.skillTagDTOList %} {% if
        skillTag.categoryName == 'STACKS' %} {% set badgeColor = 'info' %} {%
        elseif skillTag.categoryName == 'FRAMEWORKS' %} {% set badgeColor =
        'success' %} {% elseif skillTag.categoryName == 'DATABASES' %} {% set
        badgeColor = 'warning' %} {% elseif skillTag.categoryName == 'APIS' %}
        {% set badgeColor = 'primary' %} {% endif %}
        <div class="badge badge-outline badge-md badge-{{ badgeColor }}">
            {{ skillTag.name }}
        </div>
        {% endfor %}
    </div>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:rocket" class="w-6" /> Défis et solutions
    </h2>
    <div class="space-y-4 mb-8">
        {% for challenge in project.challenges %}
        <div>
            {% for c in challenge %}
            <h3>{{ c }}</h3>
            {% endfor %}
        </div>
        {% endfor %}
    </div>

    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:circle-check-filled" class="w-6" />
        Résultats et apprentissages
    </h2>
    <p class="mb-8">
        {{ project.result }}
    </p>

    {% if project.pictures | length > 0 %}
    <h2 class="text-2xl font-semibold mb-4 flex gap-2 align-middle">
        <twig:ux:icon name="tabler:camera" class="w-6" /> Visuels
    </h2>
    <div class="flex flex-row gap-4 flex-wrap mb-8">
        {% for picture in project.pictures %}
        <figure class="flex flex-col w-full md:w-[480px] mb-4">
            <a
                href="{{ asset('images/' ~ picture.picture) ~ '.png' }}"
                target="_blank"
            >
                <img
                    src=" {{ asset('images/' ~ picture.picture) ~ '.png' }} "
                    class="shadow-lg leading-none mb-4 object-cover rounded-lg aspect-3/2 flex items-center justify-center text-gray-500 outline-1 outline-gray-400"
                    alt="Capture du projet : {{ project.title }}. {{
                        picture.description
                    }}"
                />
            </a>
            <figcaption class="text-right text-sm">
                {{ picture.description }}
            </figcaption>
        </figure>
        {% endfor %}
    </div>
    {% endif %}
</section>

{% endblock %}
