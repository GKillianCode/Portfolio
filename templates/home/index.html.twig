{% extends 'base.html.twig' %} {% block title %}Portfolio Killian GODET {%
endblock %} {% block body %}

<!-- Hero -->
<div
    id="about"
    class="hero"
    style="min-height: calc(100vh - 65px); background: var(--bg)"
>
    <div class="hero-content text-left">
        <div class="max-w-5xl py-4">
            <h1 class="mb-4 text-4xl font-bold text-accent-content md:text-5xl">
                Killian Godet
            </h1>
            <p class="mb-8 text-2xl font-bold text-sedondary dark:text-secondary md:text-3xl">
                Développeur Backend PHP / Symfony
            </p>
            <p
                class="font-mono text-sm leading-7 text-accent-content md:text-lg"
            >
                Je suis Killian Godet, passionné par la
                conception d’APIs, l’architecture logicielle claire et
                l’efficacité du code.
                <br /><br />
                Après deux années riches en Java / Vue.js, j’ai décidé de me
                recentrer sur mes premières affinités : le développement backend
                en PHP / Symfony.
                <br /><br />
                Curieux, rigoureux et orienté backend, je recherche aujourd’hui
                un poste stimulant pour contribuer à des projets ambitieux en
                PHP / Symfony.
            </p>
            <div class="my-10 flex gap-4">
                <a
                    href="#"
                    class="badge border-none badge-xl duration-200 badge-primary flex gap-2"
                    style="background: oklch(28.2% 0.091 267.935)"
                    >
                    <twig:ux:icon name="tabler:brand-linkedin" class="w-6" />
                    Linked'in</a
                >
                <a
                    href="#"
                    class="badge border-none badge-xl duration-200 badge-primary flex gap-2"
                    style="background: oklch(28.2% 0.091 267.935)"
                    >
                    <twig:ux:icon name="tabler:brand-github" class="w-6" />
                    Github</a
                >
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="#projects" class="btn btn-lg btn-primary flex gap-2">
                  <twig:ux:icon name="tabler:zoom" class="w-8" />
                  Voir mes projets</a>
                <a href="#" target="_blank" class="btn btn-lg btn-secondary flex gap-2">
                  <twig:ux:icon name="tabler:file-info" class="w-8" />
                    Télécharger mon CV
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Stack -->
<section id="skills" class="mx-auto max-w-7xl px-4 pb-20">
    <h2 class="py-15 text-center text-3xl md:text-4xl font-bold text-primary uppercase">
        Compétences techniques
    </h2>
    <div>
        {% for key, skillTag in skillTagsList %} {% if key == 'STACKS' %}
        <h3 class="text-2xl">Stack technique :</h3>
        <div class="mt-2 flex flex-wrap gap-2">
            {% for stack in skillTag %}
            <span
                v-for="stack in stacks"
                class="md:bagde-xl badge badge-outline badge-md badge-info"
                >{{ stack.name }}</span
            >
            {% endfor %}
        </div>

        {% elseif key == 'FRAMEWORKS' %}
        <h3 class="text-2xl mt-8">Frameworks :</h3>
        <div class="mt-2 flex flex-wrap gap-2">
            {% for stack in skillTag %}
            <span
                v-for="stack in stacks"
                class="md:bagde-xl badge badge-outline badge-md badge-success"
                >{{ stack.name }}</span
            >
            {% endfor %}
        </div>

        {% elseif key == 'DATABASES' %}
        <h3 class="text-2xl mt-8">Base de données :</h3>
        <div class="mt-2 flex flex-wrap gap-2">
            {% for stack in skillTag %}
            <span
                v-for="stack in stacks"
                class="md:bagde-xl badge badge-outline badge-md badge-warning"
                >{{ stack.name }}</span
            >
            {% endfor %}
        </div>

        {% elseif key == 'APIS' %}
        <h3 class="text-2xl mt-8">APIs :</h3>
        <div class="mt-2 flex flex-wrap gap-2">
            {% for stack in skillTag %}
            <span
                v-for="stack in stacks"
                class="md:bagde-xl badge badge-outline badge-md badge-error"
                >{{ stack.name }}</span
            >
            {% endfor %}
        </div>
        {% endif %} {% endfor %}
    </div>
</section>

<!-- Projects -->
<div class="bg-base-300">
    <section
        id="projects"
        class="mx-auto flex max-w-7xl flex-col items-center px-4 pb-30"
    >
        <h2
            class="py-15 text-center text-3xl md:text-4xl font-bold text-primary uppercase"
        >
            Mes projets
        </h2>

        <div class="flex flex-wrap justify-center gap-4">
            {% for projectCard in projectCardsDTO %} {% include
            'partials/_project_card.html.twig' with {'projectCard': projectCard}
            %} {% endfor %}
        </div>

        <!--<RouterLink class="btn mt-8 btn-primary">Voir tous les projets</RouterLink>-->
    </section>
</div>

