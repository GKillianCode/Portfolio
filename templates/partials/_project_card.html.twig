<div class="card w-96 bg-base-100 shadow-sm md:w-100">
    <figure>
        <img
            src="{{ asset('images/' ~ projectCard.mainPictureUrl) ~ '.png' }}"
            alt="Image du projet : {{ projectCard.title }}"
        />
    </figure>
    <div class="card-body">
        <h2 class="card-title">
            <a
                href="{{
                    path('home_projectdetails', { slug: projectCard.slug })
                }}"
                class="duration-200 ease-linear hover:text-info"
            >
                {{ projectCard.title }}</a
            >
        </h2>
        <p class="font-mono">
            {{ projectCard.shortDescription }}
        </p>
        <div class="mt-4 card-actions justify-start">
            {% for skillTag in projectCard.skillTagsDTO.skillTagDTOList %} {% if
            skillTag.categoryName == 'STACKS' %} {% set badgeColor = 'info' %}
            {% elseif skillTag.categoryName == 'FRAMEWORKS' %} {% set badgeColor
            = 'success' %} {% elseif skillTag.categoryName == 'DATABASES' %} {%
            set badgeColor = 'warning' %} {% elseif skillTag.categoryName ==
            'APIS' %} {% set badgeColor = 'primary' %} {% endif %}
            <div class="badge badge-outline badge-md badge-{{ badgeColor }}">
                {{ skillTag.name }}
            </div>
            {% endfor %}
        </div>
    </div>
</div>
