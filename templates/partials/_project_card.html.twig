<div class="card w-96 bg-base-100 shadow-sm md:w-100">
    <figure>
        <img
            src="{{ asset('images/' ~ projectCard.mainPictureUrl) ~ '.png' }}"
            alt="Image du projet : {{ projectCard.title }}"
        />
    </figure>
    <div class="card-body">
        <h2 class="card-title">
            <a
                href="{{ projectCard.slug }}"
                class="duration-200 ease-linear hover:text-info"
            >
                {{ projectCard.title }}</a
            >
        </h2>
        <p class="font-mono">
            {{ projectCard.shortDescription }}
        </p>
        <div class="mt-4 card-actions justify-start">
            {#<template v-for="tag in tags" :key="tag">
                <TagComponent :tag="tag" /> </template
            >#}
        </div>
    </div>
</div>
