<section id="contact" class="bg-gray-700">
    <div class="mx-auto max-w-7xl px-4 pb-14">
        <h2
            class="py-14 text-center text-3xl md:text-4xl font-bold text-primary uppercase"
        >
            Contactez-moi !
        </h2>

        <div id="contactAlert" class="hidden mb-6 p-4 rounded-lg"></div>

        {% for label, messages in app.flashes %} {% for message in messages %}
        <div
            class="mb-6 p-4 rounded-lg {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% else %}bg-red-50 text-red-800 border border-red-200{% endif %}"
        >
            {{ message }}
        </div>
        {% endfor %} {% endfor %}

        {{ form_start(form) }}

        <div class="flex gap-4 mb-4 flex-col md:flex-row">
            <div class="flex flex-1 w-full flex-col">
                {{ form_row(form.fullName) }}
            </div>
            <div class="flex flex-1 w-full flex-col">
                {{ form_row(form.company) }}
            </div>
        </div>

        <div class="mb-4">
            {{ form_row(form.email) }}
        </div>

        <div class="mb-4">
            {{ form_row(form.message) }}
        </div>

        <button class="btn btn-primary mt-4 flex gap-2">
            Envoyer
            <twig:ux:icon name="tabler:send-2" class="w-5" />
        </button>

        {{ form_end(form) }}
    </div>

    <div class="mt-8 pb-14 text-center text-gray-100">
        <p>Vous préférez un contact direct ?</p>
        <a
            href="mailto:contact@killiangodet.fr"
            class="text-primary hover:text-error duration-150 font-medium"
        >
            contact@killiangodet.fr
        </a>
    </div>
</section>
